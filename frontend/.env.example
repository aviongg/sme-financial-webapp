# Live is the default. Demo must be an explicit build-time choice.
NEXT_PUBLIC_DATA_MODE=live
# Server-only development proxy origin. Production ingress should route /api directly.
BACKEND_API_URL=http://localhost:8080
# Set true ONLY behind the supplied trusted ingress, which overwrites x-nonce.
# The Next server must not be publicly reachable when this is true.
TRUST_INGRESS_NONCE=false
