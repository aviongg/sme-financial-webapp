ARG JAVA_BUILD_IMAGE=eclipse-temurin:21-jdk-alpine
ARG JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine
# Stage 1: Build
FROM ${JAVA_BUILD_IMAGE} AS builder
WORKDIR /workspace/app

COPY backend/.mvn backend/.mvn
COPY backend/mvnw backend/pom.xml backend/
WORKDIR /workspace/app/backend
RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B

COPY backend/src ./src
ARG SOURCE_DATE_EPOCH
RUN ./mvnw clean package -DskipTests -B ${SOURCE_DATE_EPOCH:+-Dproject.build.outputTimestamp=$SOURCE_DATE_EPOCH}

# Stage 2: Hardened Runtime
FROM ${JAVA_RUNTIME_IMAGE}
RUN addgroup -g 10001 -S finsight && adduser -u 10001 -S finsight -G finsight

WORKDIR /app
COPY --from=builder --chown=finsight:finsight /workspace/app/backend/target/sme-health-backend-*.jar app.jar

USER finsight:finsight
EXPOSE 8080

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]
