# Database & Infrastructure Security (Phase S6 Three-Plane Security Model)
POSTGRES_DB=sme_health
POSTGRES_PORT=5432

# Runtime Application Plane (DML only, no DDL/superuser)
POSTGRES_APP_USER=finsight_app
POSTGRES_APP_PASSWORD=change_me_high_entropy_app_password

# Deployment / Migration Plane (Flyway DDL only, one-shot process)
POSTGRES_MIGRATOR_USER=finsight_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me_high_entropy_migrator_password

# Administrative Recovery Plane (Cluster admin / recovery only - local socket access)
# POSTGRES_DBA_USER=finsight_dba
# POSTGRES_DBA_PASSWORD=change_me_high_entropy_dba_password

# WhatsApp Delivery (Feature 8)
WHATSAPP_PROVIDER=mock
WHATSAPP_PORTAL_URL=http://localhost:3000
WHATSAPP_SCHEDULER_TIMEZONE=Asia/Karachi
WHATSAPP_SCHEDULER_CRON=0 0 9 * * MON
WHATSAPP_TEMPLATE_NAME=financial_health_weekly_summary_v1
WHATSAPP_RECOVERY_STALE_THRESHOLD_MINUTES=15
WHATSAPP_META_BASE_URL=https://graph.facebook.com
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_TIMEOUT_SECONDS=15

# Internal Service Authentication (OCR Bridge)
INTERNAL_SERVICE_SECRET=change_me_in_production

# Application-Level Encryption (Phase S5)
FINSIGHT_CRYPTO_ACTIVE_KEY_ID=k1
FINSIGHT_CRYPTO_ALLOW_LEGACY_PLAINTEXT=false
FINSIGHT_CRYPTO_KEY_K1=change_me_base64_32_byte_random_key
