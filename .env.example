# Internal Service Authentication (OCR Bridge)
INTERNAL_SERVICE_SECRET=change_me_in_production

# Application-Level Encryption (Phase S5)
FINSIGHT_CRYPTO_ACTIVE_KEY_ID=k1
FINSIGHT_CRYPTO_ALLOW_LEGACY_PLAINTEXT=true
FINSIGHT_CRYPTO_KEY_K1=change_me_base64_32_byte_random_key
