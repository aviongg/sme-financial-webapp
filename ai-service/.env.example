# Example configuration only. Export variables in the shell; .env is not loaded automatically.
OCR_PROVIDER=google-cloud-vision
# REQUIRED for URL fetches: exact trusted storage hostnames, comma separated, no wildcards.
OCR_ALLOWED_IMAGE_HOSTS=storage.googleapis.com
OCR_DOWNLOAD_TIMEOUT_SECONDS=10
OCR_RETRY_DELAYS_SECONDS=2,4
OCR_MAX_DOCUMENT_BYTES=10485760
OCR_MAX_PDF_PAGES=5
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_URL_LENGTH=8192
OCR_MAX_TEXT_CHARS=100000
OCR_MAX_CONCURRENT_REQUESTS=4
GOOGLE_CLOUD_VISION_TIMEOUT_SECONDS=20
GOOGLE_CLOUD_VISION_ENDPOINT=vision.googleapis.com
GOOGLE_CLOUD_VISION_LANGUAGE_HINTS=
# Use Application Default Credentials; if a file is needed it must be OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/external-secure-location/adc.json
